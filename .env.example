# Backend API base URL.
# `{host}` is replaced with the current page hostname at runtime.
# Example: http://{host}:21000
VITE_API_BASE_URL=http://127.0.0.1:21000

# Runtime override (optional, same hook as the Flutter client):
#   window.__LOONGS_API_BASE_URL__
# Uncomment the script in index.html, or inject it at deploy time.
